{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div class="shop-ai-chat-container">
  <div class="lina-hint" aria-hidden="true">Je vous aide ? · نعاونك؟ 💬</div>
  <div class="shop-ai-chat-bubble lina-launcher" style="background-color: #6B2838" aria-label="Discuter avec Lina">
    <svg class="lina-agent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="44" height="44" aria-hidden="true">
      <!-- cheveux -->
      <path d="M14 30c0-12 8-20 18-20s18 8 18 20v10c0 3-2 5-4 5H18c-2 0-4-2-4-5z" fill="#2b0a10"/>
      <!-- visage -->
      <ellipse cx="32" cy="32" rx="12" ry="13.5" fill="#f3c7a6"/>
      <!-- frange -->
      <path d="M20 27c3-7 10-10 18-8 3 1 5 3 6 6-6-2-13-1-24 2z" fill="#2b0a10"/>
      <!-- yeux qui clignent -->
      <g class="lina-eyes" fill="#2b0a10"><ellipse cx="27.5" cy="32" rx="1.6" ry="1.9"/><ellipse cx="36.5" cy="32" rx="1.6" ry="1.9"/></g>
      <!-- sourire -->
      <path d="M28 38.5c2.4 2.2 5.6 2.2 8 0" stroke="#b5485c" stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <!-- corps -->
      <path d="M16 60c1-8 8-13 16-13s15 5 16 13z" fill="#E8B0BB"/>
      <!-- casque -->
      <path d="M17 32c0-10 7-17 15-17s15 7 15 17" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round"/>
      <rect x="13" y="29" width="6" height="10" rx="3" fill="#ffffff"/>
      <rect x="45" y="29" width="6" height="10" rx="3" fill="#ffffff"/>
      <!-- micro -->
      <path d="M16 38c0 5 5 8 11 8" stroke="#ffffff" stroke-width="2" fill="none" stroke-linecap="round"/>
      <circle cx="28" cy="46" r="2.2" fill="#ffffff"/>
      <!-- point « en ligne » -->
      <circle class="lina-online" cx="52" cy="14" r="5" fill="#3ccf6e" stroke="#ffffff" stroke-width="2"/>
    </svg>
  </div>

  <div class="shop-ai-chat-window">
    <div class="shop-ai-chat-header">
      <div>{{ 'chat.title' | t }}</div>
      <button class="shop-ai-chat-close">✕</button>
    </div>

    <div class="shop-ai-chat-messages">
      <!-- Messages will be added here by JavaScript -->
    </div>

    <div class="shop-ai-chat-input">
      <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
      <button class="shop-ai-chat-send">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: {{ block.settings.welcome_message | json }}
  };
</script>

{% schema %}
{
  "name": "Lina pantalon.ma",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Couleur de la bulle",
      "default": "#6B2838"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Message d'accueil",
      "default": "Bonjour 👋 Je suis Lina, votre conseillère pantalon.ma. السلام 👋 أنا لينا، غادي نعاونك تلقاي السروال اللي يعجبك! Quelle couleur vous fait envie ? / أشمن لون بغيتي؟"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "System Prompt",
      "options": [
        { "value": "pantalonMa", "label": "Conseillère pantalon.ma" }
      ],
      "default": "pantalonMa"
    }
  ]
}
{% endschema %}
